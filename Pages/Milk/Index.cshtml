@page "/milk"
@model IndexModel
@{
    ViewData["Title"] = L["Nav_Milk"].Value;
}

<h1 class="page-title">@L["Nav_Milk"]</h1>
<p class="page-lead">@L["Milk_Lead"]</p>

<form method="get" class="filter-bar row g-3 align-items-end" data-autosubmit>
    <div class="col-12 col-md-4">
        <label for="category" class="form-label">@L["Filter_Category"]</label>
        <select id="category" name="category" class="form-select">
            <option value="">@L["Filter_All"]</option>
            @foreach (var c in Enum.GetValues<MilkCategory>())
            {
                <option value="@c" selected="@(c == Model.Category)">@L.EnumLabel(c)</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-coffee">@L["Filter_Apply"]</button>
        <a asp-page="/Milk/Index" class="btn btn-outline-coffee">@L["Filter_Reset"]</a>
    </div>
</form>

@if (Model.Cards.Count == 0)
{
    <partial name="_EmptyState" />
}
else
{
    <div class="row g-4">
        @foreach (var card in Model.Cards)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <partial name="_ContentCard" model="card" />
            </div>
        }
    </div>
}
