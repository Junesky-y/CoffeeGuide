@page "/recipes"
@model IndexModel
@{
    ViewData["Title"] = L["Nav_Recipes"].Value;
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Query) || Model.Category.HasValue;
}

<div class="cg-page cg-page--recipes">
    <header class="cg-pagehead">
        <div class="cg-wrap">
            <p class="cg-kicker">@L["Home_Count", Model.Cards.Count]</p>
            <h1 class="cg-pagehead__title">@L["Nav_Recipes"]</h1>
            <p class="cg-pagehead__lead">@L["Recipes_Lead"]</p>
        </div>
    </header>
    <div class="cg-wrap">
        <button class="cg-filter-toggle" type="button" data-bs-toggle="collapse"
                data-bs-target="#filterPanel" aria-expanded="@(hasFilter ? "true" : "false")" aria-controls="filterPanel">@L["Filter_Toggle"]</button>

        <div id="filterPanel" class="collapse d-md-block @(hasFilter ? "show" : "")">
            <form method="get" class="cg-filters">
                <div class="cg-field">
                    <label for="q" class="cg-label">@L["Filter_DrinkName"]</label>
                    <input id="q" name="q" type="search" class="cg-input" value="@Model.Query" maxlength="100" enterkeyhint="search" />
                </div>
                <div class="cg-field">
                    <label for="category" class="cg-label">@L["Filter_Category"]</label>
                    <div class="cg-select">
                        <select id="category" name="category">
                            <option value="">@L["Filter_All"]</option>
                            @foreach (var c in Enum.GetValues<RecipeCategory>())
                            {
                                <option value="@c" selected="@(c == Model.Category)">@L.EnumLabel(c)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="cg-filters__actions">
                    <button type="submit" class="btn btn-coffee">@L["Filter_Apply"]</button>
                    <a asp-page="/Recipes/Index" class="cg-link">@L["Filter_Reset"]</a>
                </div>
            </form>
        </div>

        @if (Model.Cards.Count == 0)
        {
            <partial name="_EmptyState" />
        }
        else
        {
            <div class="cg-grid cg-grid--recipes">
                @foreach (var card in Model.Cards)
                {
                    <partial name="_ContentCard" model="card" />
                }
            </div>
        }
    </div>
</div>
