@page "/Error/{code:int?}"
@model ErrorModel
@{
    ViewData["Title"] = L[Model.TitleKey].Value;
}

<div class="cg-wrap">
    <div class="cg-error">
        <img src="/images/placeholders/recipe.svg" alt="" class="state-illustration" />
        <h1>@L[Model.TitleKey]</h1>
        <p>@L[Model.TextKey]</p>
        <a href="/" class="btn btn-coffee">@L["Error_Back_Home"]</a>
    </div>
</div>
