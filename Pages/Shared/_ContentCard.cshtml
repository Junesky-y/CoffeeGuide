@model CardViewModel
@{
    var detailsUrl = Url.Page(Model.DetailsPage, "Details", new { id = Model.Id });
    var buttonLabel = $"{L["Card_Details"].Value}: {Model.Title}";

    // Тип картки визначає її вигляд (див. .cg-card--* у components.css)
    var kind = Model.DetailsPage switch
    {
        PageNames.Beans => "bean",
        PageNames.Milk => "milk",
        PageNames.Syrups => "syrup",
        PageNames.Methods => "method",
        _ => "recipe"
    };
}
<article class="cg-card cg-card--@kind">
    <div class="cg-card__media">
        @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
        {
            <img src="@Model.ImagePath" alt="@Model.Title" loading="lazy" decoding="async" class="cg-card__img" />
        }
        else
        {
            <img src="@Model.Placeholder" alt="" loading="lazy" decoding="async" class="cg-card__img is-placeholder" />
        }
        @if (!string.IsNullOrWhiteSpace(Model.Badge))
        {
            <span class="cg-card__tag">@Model.Badge</span>
        }
    </div>
    <div class="cg-card__body">
        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <p class="cg-card__kicker">@Model.Subtitle</p>
        }
        <h2 class="cg-card__title">@Model.Title</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Text))
        {
            <p class="cg-card__text">@Model.Text</p>
        }
        @* Уся картка клікабельна через ::after кнопки; кнопка доступна з клавіатури *@
        <button type="button" class="cg-card__more" data-details-url="@detailsUrl" aria-label="@buttonLabel">@L["Card_Details"] <span class="cg-card__arrow" aria-hidden="true">→</span></button>
    </div>
</article>
