@* Єдине модальне вікно. Вміст заповнює wwwroot/js/details-modal.js даними з сервера. *@
<div class="modal fade cg-modal" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalTitle" aria-hidden="true"
     data-msg-loading="@L["Modal_Loading"]" data-msg-error="@L["Modal_Error"]" data-msg-notfound="@L["Modal_NotFound"]">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-lg-down">
        <div class="modal-content">
            <button type="button" class="btn-close cg-modal__close" data-bs-dismiss="modal" aria-label="@L["Modal_Close"]"></button>
            <div class="modal-body" aria-live="polite">
                <div id="detailsModalState" class="cg-modal__state" role="status" hidden>
                    <div class="spinner-border" id="detailsModalSpinner" aria-hidden="true"></div>
                    <p id="detailsModalStateText"></p>
                    <button type="button" class="btn btn-outline-coffee" id="detailsModalRetry" hidden>@L["Modal_Retry"]</button>
                </div>
                <div id="detailsModalContent" class="cg-detail" hidden>
                    <figure class="cg-detail__figure">
                        <img id="detailsModalImage" class="details-image" alt="" hidden />
                    </figure>
                    <div class="cg-detail__main">
                        <p class="cg-detail__kicker" id="detailsModalSubtitle" hidden></p>
                        <h2 class="cg-detail__title" id="detailsModalTitle" tabindex="-1"></h2>
                        <p class="cg-detail__summary" id="detailsModalSummary"></p>
                        <div id="detailsModalSections"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-coffee" data-bs-dismiss="modal">@L["Modal_Close"]</button>
            </div>
        </div>
    </div>
</div>
