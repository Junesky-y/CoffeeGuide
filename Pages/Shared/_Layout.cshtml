@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#F1EBDD" />
    <title>@ViewData["Title"] — @L["App_Name"]</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    @* Шрифти (Playfair Display, Onest, IBM Plex Mono підтримують кирилицю). Якщо вони не завантажаться, діють системні шрифти з fallback у site.css *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@@400;500&amp;family=Onest:wght@@400;500;600&amp;family=Playfair+Display:ital,wght@@0,600;0,700;0,800;1,500;1,700&amp;display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
</head>
<body class="cg-body">
    <a class="visually-hidden-focusable skip-link" href="#main">@L["Skip_To_Content"]</a>

    <partial name="_Navigation" />

    <main id="main" class="cg-main">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    @* Єдине модальне вікно для всіх сутностей *@
    <partial name="_DetailsModal" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/details-modal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
