@page "/coffee-beans"
@model IndexModel
@{
    ViewData["Title"] = L["Nav_Beans"].Value;
}

<h1 class="page-title">@L["Nav_Beans"]</h1>
<p class="page-lead">@L["Beans_Lead"]</p>

<form method="get" class="filter-bar row g-3 align-items-end" data-autosubmit>
    <div class="col-12 col-md-3">
        <label for="origin" class="form-label">@L["Filter_Origin"]</label>
        <select id="origin" name="origin" class="form-select">
            <option value="">@L["Filter_All"]</option>
            @foreach (var o in Model.Origins)
            {
                <option value="@o" selected="@(o == Model.Origin)">@o</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3">
        <label for="variety" class="form-label">@L["Filter_Variety"]</label>
        <select id="variety" name="variety" class="form-select">
            <option value="">@L["Filter_All"]</option>
            @foreach (var v in Model.Varieties)
            {
                <option value="@v" selected="@(v == Model.Variety)">@v</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3">
        <label for="roast" class="form-label">@L["Filter_Roast"]</label>
        <select id="roast" name="roast" class="form-select">
            <option value="">@L["Filter_All"]</option>
            @foreach (var r in Enum.GetValues<RoastLevel>())
            {
                <option value="@r" selected="@(r == Model.Roast)">@L.EnumLabel(r)</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-coffee">@L["Filter_Apply"]</button>
        <a asp-page="/CoffeeBeans/Index" class="btn btn-outline-coffee">@L["Filter_Reset"]</a>
    </div>
</form>

@if (Model.Cards.Count == 0)
{
    <partial name="_EmptyState" />
}
else
{
    <div class="row g-4">
        @foreach (var card in Model.Cards)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <partial name="_ContentCard" model="card" />
            </div>
        }
    </div>
}
